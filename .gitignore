.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
dist/
repo/
build/
*.egg-info/
.flatpak-builder/

# ~/.gitignore is core.excludesFile for every repository under $HOME and it
# excludes *.sh, so without this negation a clone ships no installer and no
# packaging scripts — and the release workflow fails on a file that was never
# pushed. Scoped to scripts/ once, which silently missed packaging/ later.
!**/*.sh

# Disposable output: build products, screenshots, working images, scratch
# notes. Nothing here is reviewed and nothing here is committed.
#
# It carries its own line because the machine this was written on hides it
# through a user-level excludes file, and a clone has none of that.
local.d/
