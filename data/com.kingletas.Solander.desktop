[Desktop Entry]
Type=Application
Name=Solander
GenericName=Markdown Reader
Comment=Read your Markdown vault in place, without ever writing into it
Exec=@LAUNCHER@ %f
Icon=com.kingletas.Solander
Terminal=false
Categories=Office;Viewer;GNOME;GTK;
MimeType=text/markdown;inode/directory;
Keywords=markdown;obsidian;notes;vault;reader;
StartupNotify=true
