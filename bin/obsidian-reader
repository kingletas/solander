#!/usr/bin/env bash
#
# obsidian-reader -- launch the Obsidian Reader desktop app from its source tree.
#
# Usage:
#   obsidian-reader [PATH]        open PATH as a vault or note; no PATH resumes
#   obsidian-reader --help        the app's own usage text
#
# Environment overrides:
#   OBSIDIAN_READER_HOME   source checkout (default: ~/Development/obsidian-reader)
#
# The interpreter is exec'd directly, not through uv or the venv console
# script: AppArmor attaches the app's sandbox profile by interpreter path,
# and a #! (shebang) launch does not attach it.

set -euo pipefail

READER_HOME="${OBSIDIAN_READER_HOME:-$HOME/Development/obsidian-reader}"
PYTHON="$READER_HOME/.venv/bin/python3"

if [[ ! -x "$PYTHON" ]]; then
  echo "obsidian-reader: no virtualenv at $READER_HOME/.venv -- run 'make install' in $READER_HOME" >&2
  exit 1
fi

exec "$PYTHON" -m obsidian_reader.cli "$@"
